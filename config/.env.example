# Copia a .env y rellena. NO subas .env a git (ya esta en .gitignore).

# --- Google (Gmail / Drive / Calendar) ---
# Se obtiene en Google Cloud Console > APIs & Services > Credentials > OAuth Client ID (tipo "Desktop app")
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Apify ---
# https://console.apify.com/account/integrations  (o login OAuth directo en el MCP http)
APIFY_TOKEN=

# --- Email IMAP/SMTP ---
EMAIL_ADDRESS=
EMAIL_IMAP_SERVER=
# La password va en ~/.mcp-credentials/email.pass (fichero con chmod 600), NO aqui.
